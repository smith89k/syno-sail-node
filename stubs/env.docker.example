CONTAINER_NAME=node-app
CONTAINER_REGISTRY_IMAGE=ghcr.io/smith89k/node-app:latest

NODE_ENV=production
# the port on the NAS people open, and the port the app listens on inside
APP_PORT=8083
PORT=3000
APP_TIMEZONE=Asia/Phnom_Penh
# the address people use to reach the app, e.g. http://192.168.1.20:8083
APP_URL=
# the page the health check opens to see the app is alive
HEALTH_PATH=/

DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=
